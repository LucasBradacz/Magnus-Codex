<div class="stat-grid" id="status_calculados">
  <div class="stat-box duplo">
    <%= render "personagems/campo_editavel", personagem: personagem, campo: "vida_atual", label: "Vida Atual" %>
    <div class="metade"><div class="valor"><%= personagem.vida_max %></div><div class="label">Vida Max</div></div>
  </div>
  <div class="stat-box duplo">
    <%= render "personagems/campo_editavel", personagem: personagem, campo: "mana_atual", label: "Mana Atual" %>
    <div class="metade"><div class="valor"><%= personagem.mana_max %></div><div class="label">Mana Max</div></div>
  </div>
  <div class="stat-box duplo">
    <%= render "personagems/campo_editavel", personagem: personagem, campo: "estabilidade_atual", label: "Estabilidade Atual" %>
    <div class="metade"><div class="valor"><%= personagem.estabilidade_max %></div><div class="label">Estab. Max</div></div>
  </div>
  <div class="stat-box"><div class="valor"><%= personagem.ca %></div><div class="label">CA</div></div>
  <div class="stat-box"><div class="valor"><%= personagem.acoes %></div><div class="label">Acoes</div></div>
  <div class="stat-box"><div class="valor"><%= personagem.acerto %></div><div class="label">Acerto</div></div>
  <div class="stat-box"><div class="valor"><%= personagem.movimento %></div><div class="label">Movimento</div></div>
  <div class="stat-box"><div class="valor"><%= personagem.dano_extra %></div><div class="label">Dano Extra</div></div>
  <div class="stat-box"><div class="valor"><%= personagem.cm %></div><div class="label">CM</div></div>
  <div class="stat-box"><div class="valor"><%= personagem.truque %></div><div class="label">Truque</div></div>
  <div class="stat-box">
    <%= render "personagems/campo_editavel", personagem: personagem, campo: "dinheiro", label: "Dinheiro" %>
  </div>
</div>