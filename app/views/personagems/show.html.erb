<p><%= link_to "Voltar", personagens_path %> | <%= link_to "Inicio", root_path %></p>

<div class="ficha-container">
  <div class="ficha-cabecalho">
    <h1><%= @personagem.nome %></h1>
    <p class="info-basica">
      Player: <%= @personagem.player %> &middot; Nivel: <span id="nivel_display"><%= @personagem.nivel %></span>
      &middot; <%= turbo_frame_tag "subir_nivel_area" do %>
        <%= link_to "Subir de Nivel", subir_nivel_personagem_path(@personagem) %>
      <% end %>
    </p>
    <p id="pontos_atributo_display">
      <% if @personagem.pontos_atributo_disponiveis > 0 %>
        Pontos de atributo disponiveis: <%= @personagem.pontos_atributo_disponiveis %>
      <% end %>
    </p>
  </div>

  <div class="ficha-secao">
    <div class="ficha-secao">
      <h2>Atributos</h2>
      <%= render "personagems/atributos_grid", personagem: @personagem %>
    </div>
  </div>

  <div class="ficha-secao">
    <h2>Status</h2>
    <%= render "personagems/status_calculados", personagem: @personagem %>
  </div>

  <div class="ficha-secao">
    <h2>Pentagrama</h2>
    <%= render "personagems/pentagrama", personagem: @personagem %>
  </div>

  <div class="ficha-secao">
    <h2>Grimorio</h2>
    <% if @personagem.encantamentos.any? %>
      <table class="tabela-ficha">
        <tr><th>Nome</th><th>Custo</th><th>Poder</th><th>Alcance</th><th>Tamanho</th><th>Duracao</th><th>Acoes</th><th></th></tr>
        <% @personagem.encantamentos.each do |enc| %>
          <tr>
            <td><%= enc.nome %><% if enc.observacao.present? %><br><em><%= enc.observacao %></em><% end %></td>
            <td><%= enc.custo_final %></td>
            <td><%= enc.poder_final %></td>
            <td><%= enc.alcance %></td>
            <td><%= enc.tamanho %></td>
            <td><%= enc.duracao %></td>
            <td><%= enc.acoes_necessarias %></td>
            <td><%= link_to "Editar", edit_personagem_encantamento_path(@personagem, enc) %></td>
          </tr>
        <% end %>
      </table>
    <% else %>
      <p>Nenhum encantamento salvo ainda.</p>
    <% end %>
    <div class="acoes-ficha">
      <%= link_to "Novo Encantamento", new_personagem_encantamento_path(@personagem) %>
      <%= link_to "Editar Cartas Conhecidas", edit_personagem_cartas_conhecidas_path(@personagem) %>
    </div>
  </div>

  <div class="ficha-secao">
    <h2>Inventario</h2>
    <table class="tabela-ficha">
      <tr><th>Nome</th><th>Qtd</th><th>Descricao</th><th></th></tr>
      <% @personagem.itens.each do |item| %>
        <tr>
          <td><%= item.nome %></td>
          <td><%= item.quantidade %></td>
          <td><%= item.descricao %></td>
          <td>
            <%= link_to "Editar", edit_personagem_item_path(@personagem, item) %>
            <%= button_to "Remover", personagem_item_path(@personagem, item), method: :delete, form: { data: { turbo_confirm: "Tem certeza?" } } %>
          </td>
        </tr>
      <% end %>
    </table>
    <div class="acoes-ficha">
      <%= link_to "Novo Item", new_personagem_item_path(@personagem) %>
    </div>
  </div>

  <div class="ficha-secao">
    <h2>Ataques</h2>
    <table class="tabela-ficha">
      <tr><th>Nome</th><th>Acoes</th><th>Municao</th><th>Alcance</th><th>Dano</th></tr>
      <% @personagem.encantamentos.each do |enc| %>
        <tr><td><%= enc.nome %></td><td><%= enc.acoes_necessarias %></td><td>-</td><td><%= enc.alcance %></td><td><%= enc.poder_final %></td></tr>
      <% end %>
      <% @personagem.itens.select(&:arma?).each do |item| %>
        <tr><td><%= item.nome %></td><td><%= item.acoes %></td><td><%= item.municao %></td><td><%= item.alcance %></td><td><%= item.dano %></td></tr>
      <% end %>
    </table>
  </div>
</div>