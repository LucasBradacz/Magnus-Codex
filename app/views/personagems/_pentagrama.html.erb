<div class="stat-grid" id="pentagrama">
  <div class="stat-box"><%= render "personagems/campo_editavel", personagem: personagem, campo: "nivel_superior", label: "Superior" %></div>
  <div class="stat-box"><%= render "personagems/campo_editavel", personagem: personagem, campo: "nivel_esquerda_superior", label: "Esq. Superior" %></div>
  <div class="stat-box"><%= render "personagems/campo_editavel", personagem: personagem, campo: "nivel_direita_superior", label: "Dir. Superior" %></div>
  <div class="stat-box"><%= render "personagems/campo_editavel", personagem: personagem, campo: "nivel_esquerda_inferior", label: "Esq. Inferior" %></div>
  <div class="stat-box"><%= render "personagems/campo_editavel", personagem: personagem, campo: "nivel_direita_inferior", label: "Dir. Inferior" %></div>
</div>