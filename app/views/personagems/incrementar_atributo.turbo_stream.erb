<%= turbo_stream.replace "atributos_grid" do %>
  <%= render "personagems/atributos_grid", personagem: @personagem %>
<% end %>

<%= turbo_stream.replace "pontos_atributo_display" do %>
  <p id="pontos_atributo_display">
    <% if @personagem.pontos_atributo_disponiveis > 0 %>
      Pontos de atributo disponiveis: <%= @personagem.pontos_atributo_disponiveis %>
    <% end %>
  </p>
<% end %>

<%= turbo_stream.replace "status_calculados" do %>
  <%= render "personagems/status_calculados", personagem: @personagem %>
<% end %>