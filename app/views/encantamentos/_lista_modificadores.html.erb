<div>
  <h3>Modificadores adicionados</h3>

  <% if modificador_ids_selecionados.empty? %>
    <p>Nenhum modificador adicionado ainda.</p>
  <% else %>
    <ol>
      <% modificador_ids_selecionados.each_with_index do |mod_id, index| %>
        <% modificador = Modificador.find(mod_id) %>
        <li>
          <%= hidden_field_tag "modificador_ids[]", mod_id %>
          <%= modificador.nome %>
          <button type="submit" name="remover_indice" value="<%= index %>"
                  formaction="<%= preview_path_atual %>"
                  formmethod="post" formnovalidate>Remover</button>
        </li>
      <% end %>
    </ol>
  <% end %>

  <div class="campo">
    <%= label_tag :novo_modificador_id, "Adicionar Modificador" %>
    <%= select_tag :novo_modificador_id,
                   options_from_collection_for_select(modificadors, :id, :nome),
                   include_blank: "Selecione um modificador" %>
    <button type="submit"
            formaction="<%= preview_path_atual %>"
            formmethod="post" formnovalidate>Adicionar</button>
  </div>
</div>