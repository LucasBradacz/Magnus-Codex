<%= form_with model: [@personagem, @item], local: true do |f| %>
  <div class="campo">
    <%= f.label :nome %>
    <%= f.text_field :nome %>
  </div>
  <div class="campo">
    <%= f.label :quantidade %>
    <%= f.number_field :quantidade %>
  </div>
  <div class="campo">
    <%= f.label :descricao %>
    <%= f.text_area :descricao %>
  </div>

  <p><em>Preencha os campos abaixo apenas se este item for uma arma:</em></p>
  <div class="campo">
    <%= f.label :acoes, "Acoes para usar" %>
    <%= f.number_field :acoes %>
  </div>
  <div class="campo">
    <%= f.label :municao %>
    <%= f.text_field :municao %>
  </div>
  <div class="campo">
    <%= f.label :alcance %>
    <%= f.text_field :alcance %>
  </div>
  <div class="campo">
    <%= f.label :dano %>
    <%= f.text_field :dano %>
  </div>

  <%= f.submit %>
<% end %>